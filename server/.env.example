# Port to run the server on
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/bolo-ai-platform

# JWT Secrets (use secure random strings in production)
JWT_SECRET=super-secret-jwt-access-key-change-me-in-production
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-change-me-in-production

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# OpenAI API Key (Required for vector embedding calculations)
OPENAI_API_KEY=

# Encryption Key (Must be a 32-byte hex string (64 characters total))
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Meta/WhatsApp App Secret (used to verify incoming webhook callbacks signatures)
META_APP_SECRET=

